@model StudentSuccessDashboard.Models.Assignment

@{
    ViewData["Title"] = "Assignment Details";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">

    <div>
        <h1 class="mb-1">Assignment Details</h1>
        <p class="text-muted mb-0">
            Review the selected assignment information.
        </p>
    </div>

    <a asp-controller="Dashboard"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Back to Dashboard
    </a>

</div>

<div class="card shadow-sm">

    <div class="card-body">

        <dl class="row mb-0">

            <dt class="col-sm-3">
                Course
            </dt>

            <dd class="col-sm-9">
                @Model.Course.CourseName
            </dd>

            <dt class="col-sm-3">
                Title
            </dt>

            <dd class="col-sm-9">
                @Model.Title
            </dd>

            <dt class="col-sm-3">
                Description
            </dt>

            <dd class="col-sm-9">
                @if (string.IsNullOrWhiteSpace(Model.Description))
                {
                    <span class="text-muted">
                        No description provided.
                    </span>
                }
                else
                {
                    @Model.Description
                }
            </dd>

            <dt class="col-sm-3">
                Due Date
            </dt>

            <dd class="col-sm-9">
                @Model.DueDate.ToString("F")
            </dd>

            <dt class="col-sm-3">
                Priority
            </dt>

            <dd class="col-sm-9">

                <span class="badge
                    @(Model.Priority == "High"
                                              ? "bg-danger"
                                              : Model.Priority == "Medium"
                                                  ? "bg-warning text-dark"
                                                  : "bg-info text-dark")">

                    @Model.Priority

                </span>

            </dd>

            <dt class="col-sm-3">
                Status
            </dt>

            <dd class="col-sm-9">

                <span class="badge
                    @(Model.Status == "Submitted"
                                              ? "bg-success"
                                              : Model.Status == "Completed"
                                                  ? "bg-success"
                                                  : Model.Status == "In Progress"
                                                      ? "bg-primary"
                                                      : "bg-secondary")">

                    @Model.Status

                </span>

            </dd>

            <dt class="col-sm-3">
                Points Possible
            </dt>

            <dd class="col-sm-9">
                @Model.PointsPossible
            </dd>

        </dl>

    </div>

</div>

<div class="d-flex flex-wrap gap-2 mt-3">

    <a asp-action="Edit"
       asp-route-id="@Model.AssignmentId"
       class="btn btn-primary">
        Edit Assignment
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back to Assignments
    </a>

    <a asp-controller="Calendar"
       asp-action="Index"
       asp-route-year="@Model.DueDate.Year"
       asp-route-month="@Model.DueDate.Month"
       class="btn btn-outline-primary">
        Back to Calendar
    </a>

</div>