@model StudentSuccessDashboard.Models.Assignment

@{
    ViewData["Title"] = "Delete Assignment";
}

<h1>Delete Assignment</h1>
<h3>Are you sure you want to delete this assignment?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Course</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Course.CourseName)</dd>

        <dt class="col-sm-3">Title</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Title)</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Description)</dd>

        <dt class="col-sm-3">Due Date</dt>
        <dd class="col-sm-9">@Model.DueDate.ToString("g")</dd>

        <dt class="col-sm-3">Priority</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Priority)</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Status)</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="AssignmentId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
