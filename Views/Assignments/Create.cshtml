@model StudentSuccessDashboard.Models.Assignment

@{
    ViewData["Title"] = "Create Assignment";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">

    <div>
        <h1 class="mb-1">Create Assignment</h1>

        <p class="text-muted mb-0">
            Add a new assignment and track its deadline, priority, and progress.
        </p>
    </div>

    <a asp-controller="Dashboard"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Back to Dashboard
    </a>

</div>

<div class="card shadow-sm">

    <div class="card-body">

        <div class="row">

            <div class="col-lg-7 col-md-9">

                <form asp-action="Create">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">

                        <label asp-for="CourseId"
                               class="form-label">
                            Course
                        </label>

                        <select asp-for="CourseId"
                                class="form-select"
                                asp-items="ViewBag.CourseId">

                            <option value="">
                                Select a course
                            </option>

                        </select>

                        <span asp-validation-for="CourseId"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Title"
                               class="form-label">
                            Assignment Title
                        </label>

                        <input asp-for="Title"
                               class="form-control"
                               placeholder="Example: Research Paper Draft" />

                        <span asp-validation-for="Title"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Description"
                               class="form-label">
                            Description
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Optional assignment details">
                        </textarea>

                        <span asp-validation-for="Description"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="DueDate"
                               class="form-label">
                            Due Date
                        </label>

                        <input asp-for="DueDate"
                               class="form-control"
                               type="datetime-local" />

                        <span asp-validation-for="DueDate"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Priority"
                               class="form-label">
                            Priority
                        </label>

                        <select asp-for="Priority"
                                class="form-select">

                            <option value="">
                                Select priority
                            </option>

                            <option value="Low">
                                Low
                            </option>

                            <option value="Medium">
                                Medium
                            </option>

                            <option value="High">
                                High
                            </option>

                        </select>

                        <span asp-validation-for="Priority"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Status"
                               class="form-label">
                            Status
                        </label>

                        <select asp-for="Status"
                                class="form-select">

                            <option value="Not Started">
                                Not Started
                            </option>

                            <option value="In Progress">
                                In Progress
                            </option>

                            <option value="Completed">
                                Completed
                            </option>

                            <option value="Submitted">
                                Submitted
                            </option>

                        </select>

                        <span asp-validation-for="Status"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-4">

                        <label asp-for="PointsPossible"
                               class="form-label">
                            Points Possible
                        </label>

                        <input asp-for="PointsPossible"
                               class="form-control"
                               type="number"
                               min="0" />

                        <span asp-validation-for="PointsPossible"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="d-flex flex-wrap gap-2">

                        <button type="submit"
                                class="btn btn-primary">
                            Save Assignment
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}