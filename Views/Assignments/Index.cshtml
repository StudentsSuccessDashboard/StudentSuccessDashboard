@model IEnumerable<StudentSuccessDashboard.Models.Assignment>

@{
    ViewData["Title"] = "Assignments";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">

    <div>
        <h1 class="mb-1">Assignments</h1>
        <p class="text-muted mb-0">
            Track assignment deadlines, priorities, progress, and submission status.
        </p>
    </div>

    <div class="d-flex flex-wrap gap-2">

        <a asp-action="Create"
           class="btn btn-primary">
            Create New Assignment
        </a>

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>

    </div>

</div>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">

            <h4>No Assignments Yet</h4>

            <p class="text-muted">
                Add your first assignment to begin tracking deadlines and progress.
            </p>

            <a asp-action="Create"
               class="btn btn-primary">
                Create Assignment
            </a>

        </div>
    </div>
}
else
{
    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Course</th>
                            <th>Title</th>
                            <th>Description</th>
                            <th>Due Date</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Points</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    @item.Course.CourseName
                                </td>

                                <td>
                                    <strong>
                                        @item.Title
                                    </strong>
                                </td>

                                <td>
                                    @if (string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <span class="text-muted">
                                            No description
                                        </span>
                                    }
                                    else
                                    {
                                        @item.Description
                                    }
                            </td>

                            <td>
                                @item.DueDate.ToString("MMM d, yyyy h:mm tt")
                            </td>

                            <td>

                                <span class="badge
                                            @(item.Priority == "High"
                                                                                  ? "bg-danger"
                                                                                  : item.Priority == "Medium"
                                                                                      ? "bg-warning text-dark"
                                                                                      : "bg-info text-dark")">

                                    @item.Priority

                                </span>

                            </td>

                            <td>

                                <span class="badge
                                            @(item.Status == "Submitted"
                                                                                  ? "bg-success"
                                                                                  : item.Status == "Completed"
                                                                                      ? "bg-success"
                                                                                      : item.Status == "In Progress"
                                                                                          ? "bg-primary"
                                                                                          : "bg-secondary")">

                                @item.Status

                                    </span>

                                </td>

                                <td>
                                    @item.PointsPossible
                                </td>

                                <td class="text-end">

                                    <div class="d-flex flex-wrap justify-content-end gap-2">

                                        <a asp-action="Details"
                                           asp-route-id="@item.AssignmentId"
                                           class="btn btn-outline-primary btn-sm">
                                            Details
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.AssignmentId"
                                           class="btn btn-outline-warning btn-sm">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.AssignmentId"
                                           class="btn btn-outline-danger btn-sm">
                                            Delete
                                        </a>

                                    </div>

                                </td>

                            </tr>
                                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
}