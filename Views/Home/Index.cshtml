@{
    ViewData["Title"] = "Home";
}

<style>
    .welcome-hero {
        position: relative;
        overflow: hidden;
        border-radius: 24px;
        padding: 4.5rem 3rem;
        margin-top: 1rem;
        margin-bottom: 2rem;

        background:
            radial-gradient(circle at top right,
                rgba(13, 110, 253, 0.24),
                transparent 38%),
            linear-gradient(
                135deg,
                var(--surface),
                var(--primary-soft)
            );

        border: 1px solid var(--border-soft);
        box-shadow: 0 12px 32px var(--shadow-soft);
    }

    .welcome-badge {
        display: inline-block;
        padding: 0.45rem 0.85rem;
        margin-bottom: 1.25rem;

        border-radius: 50px;

        background-color: rgba(13, 110, 253, 0.12);
        color: #0d6efd;

        font-weight: 600;
        font-size: 0.9rem;
    }

    .welcome-title {
        max-width: 800px;
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        font-weight: 750;
        line-height: 1.05;
        letter-spacing: -0.045em;
        margin-bottom: 1.25rem;
    }

    .welcome-subtitle {
        max-width: 720px;
        font-size: 1.2rem;
        color: var(--text-muted);
        line-height: 1.7;
        margin-bottom: 2rem;
    }

    .welcome-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .feature-card {
        height: 100%;
        border-top: 4px solid #0d6efd;
    }

    .feature-number {
        width: 42px;
        height: 42px;

        display: flex;
        align-items: center;
        justify-content: center;

        margin-bottom: 1rem;

        border-radius: 12px;

        background-color: var(--primary-soft);
        color: #0d6efd;

        font-weight: 700;
        font-size: 1.1rem;
    }

    .welcome-footer-card {
        border-left: 4px solid #198754;
    }

    @@media (max-width: 767px) {
        .welcome-hero {
            padding: 3rem 1.5rem;
        }

        .welcome-title {
            font-size: 2.6rem;
        }

        .welcome-subtitle {
            font-size: 1.05rem;
        }
    }
</style>

<div class="welcome-hero">

    <span class="welcome-badge">
        Your semester, organized.
    </span>

    <h1 class="welcome-title">
        Stay ahead of your coursework.
    </h1>

    <p class="welcome-subtitle">
        Student Success Dashboard brings your courses, assignments,
        exams, grades, study sessions, and deadlines together in one
        place so you can spend less time organizing and more time
        making progress.
    </p>

    <div class="welcome-actions">

        @if (User.Identity != null &&
                User.Identity.IsAuthenticated)
        {
            <a asp-controller="Dashboard"
               asp-action="Index"
               class="btn btn-primary btn-lg">
                Open My Dashboard
            </a>

            <a asp-controller="Calendar"
               asp-action="Index"
               class="btn btn-outline-primary btn-lg">
                View Calendar
            </a>
        }
        else
        {
            <a asp-area="Identity"
               asp-page="/Account/Register"
               class="btn btn-primary btn-lg">
                Get Started
            </a>

            <a asp-area="Identity"
               asp-page="/Account/Login"
               class="btn btn-outline-primary btn-lg">
                Log In
            </a>
        }

    </div>

</div>

<div class="row g-4 mb-4">

    <div class="col-md-4">

        <div class="card shadow-sm feature-card">

            <div class="card-body">

                <div class="feature-number">
                    1
                </div>

                <h4>
                    Plan Your Semester
                </h4>

                <p class="text-muted mb-0">
                    Organize semesters and courses, then keep assignments,
                    quizzes, and exams connected to the right class.
                </p>

            </div>

        </div>

    </div>

    <div class="col-md-4">

        <div class="card shadow-sm feature-card">

            <div class="card-body">

                <div class="feature-number">
                    2
                </div>

                <h4>
                    Track Your Progress
                </h4>

                <p class="text-muted mb-0">
                    Monitor assignment completion, upcoming deadlines,
                    course averages, GPA, and overdue work from one
                    dashboard.
                </p>

            </div>

        </div>

    </div>

    <div class="col-md-4">

        <div class="card shadow-sm feature-card">

            <div class="card-body">

                <div class="feature-number">
                    3
                </div>

                <h4>
                    Manage Your Time
                </h4>

                <p class="text-muted mb-0">
                    Use the academic calendar and study-session tracker
                    to see what is coming next and how much time you are
                    putting into each course.
                </p>

            </div>

        </div>

    </div>

</div>

<div class="card shadow-sm welcome-footer-card">

    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">

        <div>
            <h4 class="mb-1">
                Everything you need at a glance.
            </h4>

            <p class="text-muted mb-0">
                Search, filter, plan, track, and review your academic
                progress from one centralized workspace.
            </p>
        </div>

        @if (User.Identity != null &&
                User.Identity.IsAuthenticated)
        {
            <a asp-controller="Dashboard"
               asp-action="Index"
               class="btn btn-success">
                Go to Dashboard
            </a>
        }

    </div>

</div>