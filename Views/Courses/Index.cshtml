@model IEnumerable<StudentSuccessDashboard.Models.Course>

@{
    ViewData["Title"] = "Courses";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">

    <div>
        <h1 class="mb-1">Courses</h1>
        <p class="text-muted mb-0">
            Manage your courses and connect them to the correct semester.
        </p>
    </div>

    <div class="d-flex gap-2">

        <a asp-action="Create"
           class="btn btn-primary">
            Create New Course
        </a>

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>

    </div>

</div>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">

            <h4>No Courses Yet</h4>

            <p class="text-muted">
                Create your first course to begin tracking assignments,
                exams, grades, and study sessions.
            </p>

            <a asp-action="Create"
               class="btn btn-primary">
                Create Course
            </a>

        </div>
    </div>
}
else
{
    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Course Name</th>
                            <th>Course Code</th>
                            <th>Instructor</th>
                            <th>Credits</th>
                            <th>Semester</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @item.CourseName
                                    </strong>
                                </td>

                                <td>
                                    @item.CourseCode
                                </td>

                                <td>
                                    @item.Instructor
                                </td>

                                <td>
                                    @item.Credits
                                </td>

                                <td>
                                    @item.Semester.SemesterName
                                </td>

                                <td class="text-end">

                                    <div class="d-flex flex-wrap gap-2 justify-content-end">

                                        <a asp-action="Details"
                                           asp-route-id="@item.CourseId"
                                           class="btn btn-outline-primary btn-sm">
                                            Details
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.CourseId"
                                           class="btn btn-outline-warning btn-sm">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.CourseId"
                                           class="btn btn-outline-danger btn-sm">
                                            Delete
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
}