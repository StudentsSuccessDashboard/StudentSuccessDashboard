@using StudentSuccessDashboard.Models

@{
    ViewData["Title"] = "Academic Calendar";

    var displayMonth = (DateTime)ViewBag.DisplayMonth;

    var previousYear = (int)ViewBag.PreviousYear;
    var previousMonth = (int)ViewBag.PreviousMonth;

    var nextYear = (int)ViewBag.NextYear;
    var nextMonth = (int)ViewBag.NextMonth;

    var assignments =
        ViewBag.Assignments as List<Assignment>
        ?? new List<Assignment>();

    var quizzes =
        ViewBag.Quizzes as List<Quiz>
        ?? new List<Quiz>();

    var exams =
        ViewBag.Exams as List<Exam>
        ?? new List<Exam>();

    var firstDayOfMonth =
        new DateTime(
            displayMonth.Year,
            displayMonth.Month,
            1
        );

    var daysInMonth =
        DateTime.DaysInMonth(
            displayMonth.Year,
            displayMonth.Month
        );

    var startingColumn =
        (int)firstDayOfMonth.DayOfWeek;

    var totalCells =
        startingColumn + daysInMonth;

    var numberOfRows =
        (int)Math.Ceiling(
            totalCells / 7.0
        );

    var today =
        DateTime.UtcNow.Date;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">

    <div>
        <h1 class="mb-1">
            Academic Calendar
        </h1>

        <p class="text-muted mb-0">
            View assignments, quizzes, and exams by date.
        </p>
    </div>

    <a asp-controller="Dashboard"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Back to Dashboard
    </a>

</div>


<div class="card shadow-sm mb-4">

    <div class="card-body">

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

            <a asp-action="Index"
               asp-route-year="@previousYear"
               asp-route-month="@previousMonth"
               class="btn btn-outline-primary">
                Previous
            </a>

            <div class="text-center">

                <h2 class="mb-1">
                    @displayMonth.ToString("MMMM yyyy")
                </h2>

                <a asp-action="Index"
                   class="btn btn-sm btn-outline-secondary">
                    Return to Current Month
                </a>

            </div>

            <a asp-action="Index"
               asp-route-year="@nextYear"
               asp-route-month="@nextMonth"
               class="btn btn-outline-primary">
                Next
            </a>

        </div>

    </div>

</div>


<div class="card shadow-sm mb-4">

    <div class="card-body py-3">

        <div class="d-flex flex-wrap align-items-center gap-3">

            <strong>
                Event Types:
            </strong>

            <span class="badge bg-primary">
                Assignment
            </span>

            <span class="badge bg-success">
                Quiz
            </span>

            <span class="badge bg-danger">
                Exam
            </span>

        </div>

    </div>

</div>


<div class="card shadow-sm">

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-bordered calendar-table mb-0">

                <thead>

                    <tr class="text-center">

                        <th>Sunday</th>
                        <th>Monday</th>
                        <th>Tuesday</th>
                        <th>Wednesday</th>
                        <th>Thursday</th>
                        <th>Friday</th>
                        <th>Saturday</th>

                    </tr>

                </thead>

                <tbody>

                    @{
                        var currentDay = 1;
                    }

                    @for (var row = 0; row < numberOfRows; row++)
                    {
                        <tr>

                            @for (var column = 0; column < 7; column++)
                            {
                                var cellIndex =
                                (row * 7) + column;

                                if (cellIndex < startingColumn
                                || currentDay > daysInMonth)
                                {
                                    <td class="calendar-empty">
                                    </td>
                                }
                                else
                                {
                                    var currentDate =
                                    new DateTime(
                                    displayMonth.Year,
                                    displayMonth.Month,
                                    currentDay
                                    );

                                    var dayAssignments =
                                    assignments
                                    .Where(a =>
                                    a.DueDate.Date
                                    == currentDate.Date)
                                    .ToList();

                                    var dayQuizzes =
                                    quizzes
                                    .Where(q =>
                                    q.DueDate.Date
                                    == currentDate.Date)
                                    .ToList();

                                    var dayExams =
                                    exams
                                    .Where(e =>
                                    e.ExamDate.Date
                                    == currentDate.Date)
                                    .ToList();

                                    var isToday =
                                    currentDate.Date
                                    == today;

                                    <td class="calendar-day @(isToday ? "calendar-today" : "")">

                                        <div class="d-flex justify-content-between align-items-center mb-2">

                                            <strong class="calendar-date-number">
                                                @currentDay
                                            </strong>

                                            @if (isToday)
                                            {
                                                <span class="badge bg-dark">
                                                    Today
                                                </span>
                                            }

                                        </div>


                                        <div class="d-grid gap-1">

                                            @foreach (var assignment in dayAssignments)
                                            {
                                                <a asp-controller="Assignments"
                                                   asp-action="Details"
                                                   asp-route-id="@assignment.AssignmentId"
                                                   class="badge bg-primary text-decoration-none text-start text-wrap">

                                                    @assignment.Title

                                                    @if (assignment.Course != null)
                                                    {
                                                        <span>
                                                            · @assignment.Course.CourseName
                                                        </span>
                                                    }

                                                </a>
                                            }


                                            @foreach (var quiz in dayQuizzes)
                                            {
                                                <a asp-controller="Quizzes"
                                                   asp-action="Details"
                                                   asp-route-id="@quiz.QuizId"
                                                   class="badge bg-success text-decoration-none text-start text-wrap">

                                                    @quiz.QuizName

                                                    @if (quiz.Course != null)
                                                    {
                                                        <span>
                                                            · @quiz.Course.CourseName
                                                        </span>
                                                    }

                                                </a>
                                            }


                                            @foreach (var exam in dayExams)
                                            {
                                                <a asp-controller="Exams"
                                                   asp-action="Details"
                                                   asp-route-id="@exam.ExamId"
                                                   class="badge bg-danger text-decoration-none text-start text-wrap">

                                                    @exam.ExamName

                                                    @if (exam.Course != null)
                                                    {
                                                        <span>
                                                            · @exam.Course.CourseName
                                                        </span>
                                                    }

                                                </a>
                                            }

                                        </div>

                                    </td>

                                    currentDay++;
                                }
                            }

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<style>

    .calendar-table {
        table-layout: fixed;
        min-width: 900px;
    }

        .calendar-table th {
            font-weight: 650;
            padding: 0.9rem;
        }

    .calendar-day {
        height: 150px;
        vertical-align: top;
        padding: 0.75rem !important;
        background-color: var(--surface);
    }

    .calendar-empty {
        background-color: var(--surface-soft) !important;
    }

    .calendar-date-number {
        font-size: 1rem;
        color: var(--text-heading);
    }

    .calendar-today {
        box-shadow: inset 0 0 0 2px #0d6efd;
        background-color: var(--primary-soft) !important;
    }

    .calendar-day .badge {
        display: block;
        width: 100%;
        padding: 0.55rem 0.65rem;
        line-height: 1.3;
    }

    .calendar-day a.badge:hover {
        opacity: 0.88;
        transform: translateY(-1px);
    }

</style>