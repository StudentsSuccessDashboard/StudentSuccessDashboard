@{
    ViewData["Title"] = "Dashboard";
}

<h1>Student Success Dashboard</h1>

<p>
    Welcome to your academic productivity dashboard.
</p>

<div class="row">

    <div class="col-md-3">
        <h3>Courses</h3>
        <p>Manage enrolled courses.</p>

        <a asp-controller="Courses"
           asp-action="Index"
           class="btn btn-primary">
            View Courses
        </a>

        <a asp-controller="Courses"
           asp-action="Create"
           class="btn btn-success mt-2">
            Add Course
        </a>
    </div>

    <div class="col-md-3">
        <h3>Assignments</h3>
        <p>Track upcoming deadlines.</p>

        <a href="#" class="btn btn-primary">
            View Assignments
        </a>
    </div>

    <div class="col-md-3">
        <h3>Study Sessions</h3>
        <p>Record study activity.</p>

        <a asp-controller="StudySessions"
           asp-action="Index"
           class="btn btn-primary">
            View Study Sessions
        </a>
    </div>

    <div class="col-md-3">
        <h3>Grades</h3>
        <p>Monitor academic progress.</p>

        <a href="#" class="btn btn-primary">
            View Grades
        </a>
    </div>

</div>

<div class="row mt-4">

    <div class="col-md-3">
        <h3>Quizzes</h3>
        <p>Track quizzes and upcoming quiz deadlines.</p>

        <a asp-controller="Quizzes"
           asp-action="Index"
           class="btn btn-primary">
            View Quizzes
        </a>

        <a asp-controller="Quizzes"
           asp-action="Create"
           class="btn btn-success mt-2">
            Add Quiz
        </a>
    </div>

    <div class="col-md-3">
        <h3>Exams</h3>
        <p>Track exams and upcoming exam dates.</p>

        <a asp-controller="Exams"
           asp-action="Index"
           class="btn btn-primary">
            View Exams
        </a>

        <a asp-controller="Exams"
           asp-action="Create"
           class="btn btn-success mt-2">
            Add Exam
        </a>
    </div>

</div>