@{
    ViewData["Title"] = "Dashboard";
}

<h1>Student Success Dashboard</h1>

<p>
    Welcome to your academic productivity dashboard.
</p>

<div class="row">

    <div class="col-md-3">
        <h3>Courses</h3>
        <p>Manage enrolled courses.</p>

        <a asp-controller="Courses"
           asp-action="Index"
           class="btn btn-primary">
            View Courses
        </a>

        <a asp-controller="Courses"
           asp-action="Create"
           class="btn btn-success mt-2">
            Add Course
        </a>
    </div>

    <div class="col-md-3">
        <h3>Assignments</h3>
        <p>Track upcoming deadlines.</p>

        <a href="#" class="btn btn-primary">
            View Assignments
        </a>
    </div>

    <div class="col-md-3">
        <h3>Study Sessions</h3>
        <p>Record study activity.</p>

        <a href="#" class="btn btn-primary">
            View Study Sessions
        </a>
    </div>

    <div class="col-md-3">
        <h3>Grades</h3>
        <p>Monitor academic progress.</p>

        <a href="#" class="btn btn-primary">
            View Grades
        </a>
    </div>

</div>