@model StudentSuccessDashboard.Models.Quiz

@{
    ViewData["Title"] = "Quiz Details";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">

    <div>
        <h1 class="mb-1">Quiz Details</h1>
        <p class="text-muted mb-0">
            Review the selected quiz information.
        </p>
    </div>

    <a asp-controller="Dashboard"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Back to Dashboard
    </a>

</div>

<div class="card shadow-sm">

    <div class="card-body">

        <dl class="row mb-0">

            <dt class="col-sm-3">
                Course
            </dt>

            <dd class="col-sm-9">
                @Model.Course.CourseName
            </dd>

            <dt class="col-sm-3">
                Quiz
            </dt>

            <dd class="col-sm-9">
                @Model.QuizName
            </dd>

            <dt class="col-sm-3">
                Due Date
            </dt>

            <dd class="col-sm-9">
                @Model.DueDate.ToString("F")
            </dd>

            <dt class="col-sm-3">
                Points Possible
            </dt>

            <dd class="col-sm-9">
                @Model.PointsPossible
            </dd>

        </dl>

    </div>

</div>

<div class="d-flex flex-wrap gap-2 mt-3">

    <a asp-action="Edit"
       asp-route-id="@Model.QuizId"
       class="btn btn-primary">
        Edit Quiz
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back to Quizzes
    </a>

    <a asp-controller="Calendar"
       asp-action="Index"
       asp-route-year="@Model.DueDate.Year"
       asp-route-month="@Model.DueDate.Month"
       class="btn btn-outline-primary">
        Back to Calendar
    </a>

</div>