@model StudentSuccessDashboard.Models.Quiz

@{
    ViewData["Title"] = "Quiz Details";
}

<h1>Quiz Details</h1>

<div>
    <h4>Quiz</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.QuizName)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.QuizName)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.DueDate)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.DueDate)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.PointsPossible)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.PointsPossible)
        </dd>

        <dt class="col-sm-3">
            Course
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Course.CourseName)
        </dd>
    </dl>
</div>

<div class="d-flex flex-wrap gap-2">
    <a asp-action="Edit"
       asp-route-id="@Model?.QuizId"
       class="btn btn-primary">
        Edit
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back to List
    </a>

    <a asp-controller="Calendar"
       asp-action="Index"
       asp-route-year="@Model.DueDate.Year"
       asp-route-month="@Model.DueDate.Month"
       class="btn btn-outline-primary">
        Back to Calendar
    </a>
</div>