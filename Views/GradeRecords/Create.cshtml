@model StudentSuccessDashboard.Models.GradeRecord

@{
    ViewData["Title"] = "Add Grade";
}

<h1>Add Grade</h1>

<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">

            <div asp-validation-summary="All"
                 class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Category"
                       class="control-label"></label>

                <input asp-for="Category"
                       class="form-control"
                       placeholder="Example: Assignment, Quiz, Exam" />

                <span asp-validation-for="Category"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Score"
                       class="control-label"></label>

                <input asp-for="Score"
                       class="form-control"
                       type="number"
                       min="0"
                       max="100"
                       step="0.01"
                       placeholder="0-100" />

                <span asp-validation-for="Score"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Weight"
                       class="control-label"></label>

                <input asp-for="Weight"
                       class="form-control"
                       type="number"
                       min="0"
                       max="100"
                       step="0.01"
                       placeholder="Percentage of course grade" />

                <span asp-validation-for="Weight"
                      class="text-danger"></span>

                <small class="form-text text-muted">
                    Enter the grading weight as a percentage.
                    For example, enter 30 for 30%.
                </small>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CourseId"
                       class="control-label">
                    Course
                </label>

                <select asp-for="CourseId"
                        class="form-control"
                        asp-items="ViewBag.CourseId">
                    <option value="">
                        -- Select a Course --
                    </option>
                </select>

                <span asp-validation-for="CourseId"
                      class="text-danger"></span>
            </div>

            <div class="mt-3">
                <input type="submit"
                       value="Add Grade"
                       class="btn btn-primary" />

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Back to Grades
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}