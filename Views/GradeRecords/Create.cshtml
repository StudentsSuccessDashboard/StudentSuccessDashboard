@model StudentSuccessDashboard.Models.GradeRecord

@{
    ViewData["Title"] = "Add Grade";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">

    <div>
        <h1 class="mb-1">Add Grade</h1>

        <p class="text-muted mb-0">
            Add a grading category and its current score and weight.
        </p>
    </div>

    <a asp-controller="Dashboard"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Back to Dashboard
    </a>

</div>

<div class="card shadow-sm">

    <div class="card-body">

        <div class="row">

            <div class="col-lg-7 col-md-9">

                <form asp-action="Create">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">

                        <label asp-for="CourseId"
                               class="form-label">
                            Course
                        </label>

                        <select asp-for="CourseId"
                                class="form-select"
                                asp-items="ViewBag.CourseId">

                            <option value="">
                                Select a course
                            </option>

                        </select>

                        <span asp-validation-for="CourseId"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Category"
                               class="form-label">
                            Grading Category
                        </label>

                        <input asp-for="Category"
                               class="form-control"
                               placeholder="Example: Assignments, Exams, Quizzes" />

                        <span asp-validation-for="Category"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Score"
                               class="form-label">
                            Current Score (%)
                        </label>

                        <input asp-for="Score"
                               class="form-control"
                               type="number"
                               step="0.01"
                               min="0"
                               max="100" />

                        <span asp-validation-for="Score"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-4">

                        <label asp-for="Weight"
                               class="form-label">
                            Category Weight (%)
                        </label>

                        <input asp-for="Weight"
                               class="form-control"
                               type="number"
                               step="0.01"
                               min="0"
                               max="100" />

                        <div class="form-text">
                            The total grading weight for a course cannot exceed 100%.
                        </div>

                        <span asp-validation-for="Weight"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="d-flex flex-wrap gap-2">

                        <button type="submit"
                                class="btn btn-primary">
                            Save Grade
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}