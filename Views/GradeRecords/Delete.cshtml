@model StudentSuccessDashboard.Models.GradeRecord

@{
    ViewData["Title"] = "Delete Grade";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">

    <div>
        <h1 class="mb-1">Delete Grade</h1>

        <p class="text-muted mb-0">
            Review the grade record before permanently deleting it.
        </p>
    </div>

    <a asp-controller="Dashboard"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Back to Dashboard
    </a>

</div>

<div class="card shadow-sm border-danger">

    <div class="card-body">

        <div class="alert alert-danger">
            Are you sure you want to delete this grade record?
            This action cannot be undone and may change the calculated course average and GPA.
        </div>

        <dl class="row">

            <dt class="col-sm-3">
                Course
            </dt>

            <dd class="col-sm-9">
                @Model.Course.CourseName
            </dd>

            <dt class="col-sm-3">
                Category
            </dt>

            <dd class="col-sm-9">
                @Model.Category
            </dd>

            <dt class="col-sm-3">
                Score
            </dt>

            <dd class="col-sm-9">
                @Model.Score.ToString("0.##")%
            </dd>

            <dt class="col-sm-3">
                Category Weight
            </dt>

            <dd class="col-sm-9">
                @Model.Weight.ToString("0.##")%
            </dd>

        </dl>

        <form asp-action="Delete">

            <input type="hidden"
                   asp-for="GradeRecordId" />

            <div class="d-flex flex-wrap gap-2">

                <button type="submit"
                        class="btn btn-danger">
                    Delete Grade
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>