@model IEnumerable<StudentSuccessDashboard.Models.StudySession>

@{
    ViewData["Title"] = "Study Sessions";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">

    <div>
        <h1 class="mb-1">Study Sessions</h1>

        <p class="text-muted mb-0">
            Track your study time and review your recent study activity.
        </p>
    </div>

    <div class="d-flex flex-wrap gap-2">

        <a asp-action="Create"
           class="btn btn-primary">
            Add Study Session
        </a>

        <a asp-action="Timer"
           class="btn btn-outline-primary">
            Start Study Timer
        </a>

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>

    </div>

</div>

@if (!Model.Any())
{
    <div class="card shadow-sm">

        <div class="card-body text-center py-5">

            <h4>No Study Sessions Yet</h4>

            <p class="text-muted">
                Record a study session manually or use the study timer
                to begin tracking your study activity.
            </p>

            <div class="d-flex flex-wrap justify-content-center gap-2">

                <a asp-action="Create"
                   class="btn btn-primary">
                    Add Study Session
                </a>

                <a asp-action="Timer"
                   class="btn btn-outline-primary">
                    Start Timer
                </a>

            </div>

        </div>

    </div>
}
else
{
    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table align-middle mb-0">

                    <thead>

                        <tr>
                            <th>Course</th>
                            <th>Topic</th>
                            <th>Date</th>
                            <th>Duration</th>
                            <th>Notes</th>
                            <th class="text-end">Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    @item.Course.CourseName
                                </td>

                                <td>
                                    <strong>
                                        @item.Topic
                                    </strong>
                                </td>

                                <td>
                                    @item.SessionDate.ToString("MMM d, yyyy h:mm tt")
                                </td>

                                <td>
                                    <span class="badge bg-primary">
                                        @item.DurationMinutes min
                                    </span>
                                </td>

                                <td>

                                    @if (string.IsNullOrWhiteSpace(item.Notes))
                                    {
                                        <span class="text-muted">
                                            No notes
                                        </span>
                                    }
                                    else
                                    {
                                        @item.Notes
                                    }

                                </td>

                                <td class="text-end">

                                    <div class="d-flex flex-wrap justify-content-end gap-2">

                                        <a asp-action="Edit"
                                           asp-route-id="@item.StudySessionId"
                                           class="btn btn-outline-warning btn-sm">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.StudySessionId"
                                           class="btn btn-outline-danger btn-sm">
                                            Delete
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
}