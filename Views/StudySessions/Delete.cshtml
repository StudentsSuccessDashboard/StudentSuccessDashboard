@model StudentSuccessDashboard.Models.StudySession

@{
    ViewData["Title"] = "Delete Study Session";
}

<h1>Delete Study Session</h1>

<p>
    Are you sure you want to delete this study session?
</p>

<div class="mb-3">
    <strong>Course:</strong>
    @Model.Course.CourseName
</div>

<div class="mb-3">
    <strong>Topic:</strong>
    @Model.Topic
</div>

<div class="mb-3">
    <strong>Session Date:</strong>
    @Model.SessionDate.ToString("g")
</div>

<div class="mb-3">
    <strong>Duration:</strong>
    @Model.DurationMinutes minutes
</div>

<div class="mb-3">
    <strong>Notes:</strong>
    @Model.Notes
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="StudySessionId" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>