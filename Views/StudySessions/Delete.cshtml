@model StudentSuccessDashboard.Models.StudySession

@{
    ViewData["Title"] = "Delete Study Session";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">

    <div>
        <h1 class="mb-1">Delete Study Session</h1>

        <p class="text-muted mb-0">
            Review the study session before permanently deleting it.
        </p>
    </div>

    <a asp-controller="Dashboard"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Back to Dashboard
    </a>

</div>

<div class="card shadow-sm border-danger">

    <div class="card-body">

        <div class="alert alert-danger">
            Are you sure you want to delete this study session?
            This action cannot be undone.
        </div>

        <dl class="row">

            <dt class="col-sm-3">
                Course
            </dt>

            <dd class="col-sm-9">
                @Model.Course.CourseName
            </dd>

            <dt class="col-sm-3">
                Topic
            </dt>

            <dd class="col-sm-9">
                @Model.Topic
            </dd>

            <dt class="col-sm-3">
                Session Date
            </dt>

            <dd class="col-sm-9">
                @Model.SessionDate.ToString("F")
            </dd>

            <dt class="col-sm-3">
                Duration
            </dt>

            <dd class="col-sm-9">
                @Model.DurationMinutes minutes
            </dd>

            <dt class="col-sm-3">
                Notes
            </dt>

            <dd class="col-sm-9">

                @if (string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <span class="text-muted">
                        No notes provided.
                    </span>
                }
                else
                {
                    @Model.Notes
                }

            </dd>

        </dl>

        <form asp-action="Delete">

            <input type="hidden"
                   asp-for="StudySessionId" />

            <div class="d-flex flex-wrap gap-2">

                <button type="submit"
                        class="btn btn-danger">
                    Delete Study Session
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>