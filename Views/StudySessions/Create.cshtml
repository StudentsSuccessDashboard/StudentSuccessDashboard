@model StudentSuccessDashboard.Models.StudySession

@{
    ViewData["Title"] = "Add Study Session";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">

    <div>
        <h1 class="mb-1">Add Study Session</h1>

        <p class="text-muted mb-0">
            Manually record study time for one of your courses.
        </p>
    </div>

    <a asp-controller="Dashboard"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Back to Dashboard
    </a>

</div>

<div class="card shadow-sm">

    <div class="card-body">

        <div class="row">

            <div class="col-lg-7 col-md-9">

                <form asp-action="Create">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger">
                    </div>

                    <div class="mb-3">

                        <label asp-for="CourseId"
                               class="form-label">
                            Course
                        </label>

                        <select asp-for="CourseId"
                                class="form-select"
                                asp-items="ViewBag.CourseId">

                            <option value="">
                                Select a course
                            </option>

                        </select>

                        <span asp-validation-for="CourseId"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Topic"
                               class="form-label">
                            Study Topic
                        </label>

                        <input asp-for="Topic"
                               class="form-control"
                               placeholder="Example: Chapter 5 review" />

                        <span asp-validation-for="Topic"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="SessionDate"
                               class="form-label">
                            Session Date
                        </label>

                        <input asp-for="SessionDate"
                               class="form-control"
                               type="datetime-local" />

                        <span asp-validation-for="SessionDate"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="DurationMinutes"
                               class="form-label">
                            Duration in Minutes
                        </label>

                        <input asp-for="DurationMinutes"
                               class="form-control"
                               type="number"
                               min="1"
                               max="1440" />

                        <span asp-validation-for="DurationMinutes"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-4">

                        <label asp-for="Notes"
                               class="form-label">
                            Notes
                        </label>

                        <textarea asp-for="Notes"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Optional notes about the session">
                        </textarea>

                        <span asp-validation-for="Notes"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="d-flex flex-wrap gap-2">

                        <button type="submit"
                                class="btn btn-primary">
                            Save Study Session
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Cancel
                        </a>

                        <a asp-action="Timer"
                           class="btn btn-outline-primary">
                            Use Timer Instead
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}