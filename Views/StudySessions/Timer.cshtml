@{
    ViewData["Title"] = "Study Timer";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">

    <div>
        <h1 class="mb-1">Study Timer</h1>

        <p class="text-muted mb-0">
            Track a focused study session and save the time directly
            to your study history.
        </p>
    </div>

    <a asp-controller="Dashboard"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Back to Dashboard
    </a>

</div>

<div class="row justify-content-center">

    <div class="col-lg-8">

        <div class="card shadow-sm">

            <div class="card-body p-4">

                <form asp-action="SaveTimerSession"
                      method="post"
                      id="timerForm">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label for="CourseId"
                                   class="form-label">
                                Course
                            </label>

                            <select id="CourseId"
                                    name="CourseId"
                                    class="form-select"
                                    asp-items="ViewBag.CourseId"
                                    required>

                                <option value="">
                                    Select a course
                                </option>

                            </select>

                        </div>

                        <div class="col-md-6">

                            <label for="Topic"
                                   class="form-label">
                                Study Topic
                            </label>

                            <input id="Topic"
                                   name="Topic"
                                   class="form-control"
                                   placeholder="Example: Exam review"
                                   required />

                        </div>

                        <div class="col-12">

                            <label for="Notes"
                                   class="form-label">
                                Notes
                            </label>

                            <textarea id="Notes"
                                      name="Notes"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Optional notes about this study session">
                            </textarea>

                        </div>

                    </div>

                    <div class="text-center my-5">

                        <p class="text-muted mb-2">
                            Current Study Time
                        </p>

                        <div id="timerDisplay"
                             class="display-1 fw-bold mb-4"
                             style="font-variant-numeric: tabular-nums;">
                            00:00:00
                        </div>

                        <div class="d-flex flex-wrap justify-content-center gap-2">

                            <button type="button"
                                    id="startButton"
                                    class="btn btn-success btn-lg">
                                Start
                            </button>

                            <button type="button"
                                    id="pauseButton"
                                    class="btn btn-warning btn-lg"
                                    disabled>
                                Pause
                            </button>

                            <button type="button"
                                    id="resetButton"
                                    class="btn btn-outline-secondary btn-lg">
                                Reset
                            </button>

                        </div>

                    </div>

                    <input type="hidden"
                           id="DurationMinutes"
                           name="DurationMinutes"
                           value="0" />

                    <div class="border rounded p-3 mb-4 bg-light">

                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">

                            <div>

                                <strong>
                                    Session Time to Save
                                </strong>

                                <div class="text-muted small"
                                     id="saveTimeSummary">
                                    Start the timer to begin recording your session.
                                </div>

                            </div>

                            <span class="badge bg-primary fs-6"
                                  id="minuteBadge">
                                0 min
                            </span>

                        </div>

                    </div>

                    <div class="d-flex flex-wrap justify-content-between gap-2">

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Back to Study Sessions
                        </a>

                        <button type="submit"
                                id="saveButton"
                                class="btn btn-primary"
                                disabled>
                            Save Study Session
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const timerDisplay =
            document.getElementById("timerDisplay");

        const startButton =
            document.getElementById("startButton");

        const pauseButton =
            document.getElementById("pauseButton");

        const resetButton =
            document.getElementById("resetButton");

        const saveButton =
            document.getElementById("saveButton");

        const durationInput =
            document.getElementById("DurationMinutes");

        const minuteBadge =
            document.getElementById("minuteBadge");

        const saveTimeSummary =
            document.getElementById("saveTimeSummary");

        const timerForm =
            document.getElementById("timerForm");

        let elapsedSeconds = 0;
        let timerInterval = null;
        let isRunning = false;


        function formatTime(totalSeconds) {

            const hours =
                Math.floor(totalSeconds / 3600);

            const minutes =
                Math.floor(
                    (totalSeconds % 3600) / 60
                );

            const seconds =
                totalSeconds % 60;

            return (
                String(hours).padStart(2, "0")
                + ":"
                + String(minutes).padStart(2, "0")
                + ":"
                + String(seconds).padStart(2, "0")
            );
        }


        function updateDisplay() {

            timerDisplay.textContent =
                formatTime(elapsedSeconds);

            let minutesToSave = 0;

            if (elapsedSeconds > 0) {

                minutesToSave =
                    Math.max(
                        1,
                        Math.ceil(
                            elapsedSeconds / 60
                        )
                    );
            }

            durationInput.value =
                minutesToSave;

            minuteBadge.textContent =
                minutesToSave
                + (minutesToSave === 1
                    ? " min"
                    : " min");

            if (elapsedSeconds > 0) {

                saveButton.disabled = false;

                saveTimeSummary.textContent =
                    "This session will be recorded as "
                    + minutesToSave
                    + (minutesToSave === 1
                        ? " minute."
                        : " minutes.");
            }
            else {

                saveButton.disabled = true;

                saveTimeSummary.textContent =
                    "Start the timer to begin recording your session.";
            }
        }


        function startTimer() {

            if (isRunning) {
                return;
            }

            isRunning = true;

            startButton.disabled = true;
            pauseButton.disabled = false;

            timerInterval =
                setInterval(function () {

                    elapsedSeconds++;

                    updateDisplay();

                }, 1000);
        }


        function pauseTimer() {

            if (!isRunning) {
                return;
            }

            clearInterval(timerInterval);

            timerInterval = null;
            isRunning = false;

            startButton.disabled = false;
            pauseButton.disabled = true;

            startButton.textContent = "Resume";
        }


        function resetTimer() {

            if (timerInterval != null) {

                clearInterval(
                    timerInterval
                );
            }

            timerInterval = null;
            isRunning = false;
            elapsedSeconds = 0;

            startButton.disabled = false;
            pauseButton.disabled = true;

            startButton.textContent = "Start";

            updateDisplay();
        }


        startButton.addEventListener(
            "click",
            startTimer
        );


        pauseButton.addEventListener(
            "click",
            pauseTimer
        );


        resetButton.addEventListener(
            "click",
            resetTimer
        );


        timerForm.addEventListener(
            "submit",
            function (event) {

                if (elapsedSeconds <= 0) {

                    event.preventDefault();

                    alert(
                        "Please start the timer before saving the study session."
                    );

                    return;
                }

                const course =
                    document.getElementById(
                        "CourseId"
                    ).value;

                const topic =
                    document.getElementById(
                        "Topic"
                    ).value.trim();

                if (!course || !topic) {

                    event.preventDefault();

                    alert(
                        "Please select a course and enter a study topic before saving."
                    );

                    return;
                }

                if (timerInterval != null) {

                    clearInterval(
                        timerInterval
                    );
                }

                updateDisplay();
            }
        );


        updateDisplay();
    });
</script>