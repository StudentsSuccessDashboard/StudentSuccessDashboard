@{
    ViewData["Title"] = "Study Timer";
}

<h1>Study Timer</h1>

<p>
    Use the timer to track a focused study session and save it when you are finished.
</p>

<div class="mb-3">
    <label for="courseId" class="form-label">Course</label>
    <select id="courseId"
            class="form-select"
            asp-items="ViewBag.CourseId">
        <option value="">Select a course</option>
    </select>
</div>

<div class="mb-3">
    <label for="topic" class="form-label">Topic</label>
    <input id="topic"
           class="form-control"
           type="text" />
</div>

<div class="mb-3">
    <label for="notes" class="form-label">Notes</label>
    <textarea id="notes"
              class="form-control"
              rows="4"></textarea>
</div>

<div class="mb-4">
    <h2 id="timerDisplay">00:00:00</h2>
</div>

<div class="mb-3">
    <button id="startButton"
            type="button"
            class="btn btn-success">
        Start
    </button>

    <button id="pauseButton"
            type="button"
            class="btn btn-warning">
        Pause
    </button>

    <button id="resetButton"
            type="button"
            class="btn btn-secondary">
        Reset
    </button>

    <button id="saveButton"
            type="button"
            class="btn btn-primary">
        Save Session
    </button>
</div>

<div id="timerMessage"
     class="mt-3">
</div>

<p>
    <a asp-action="Index"
       class="btn btn-outline-secondary">
        Back to Study Sessions
    </a>
</p>

<form id="saveSessionForm"
      asp-action="SaveTimerSession"
      method="post">

    @Html.AntiForgeryToken()

    <input type="hidden"
           id="hiddenCourseId"
           name="CourseId" />

    <input type="hidden"
           id="hiddenTopic"
           name="Topic" />

    <input type="hidden"
           id="hiddenNotes"
           name="Notes" />

    <input type="hidden"
           id="hiddenDurationMinutes"
           name="DurationMinutes" />
</form>

<script>
    let elapsedSeconds = 0;
    let timerInterval = null;

    const timerDisplay = document.getElementById("timerDisplay");
    const startButton = document.getElementById("startButton");
    const pauseButton = document.getElementById("pauseButton");
    const resetButton = document.getElementById("resetButton");
    const saveButton = document.getElementById("saveButton");

    const courseId = document.getElementById("courseId");
    const topic = document.getElementById("topic");
    const notes = document.getElementById("notes");

    const hiddenCourseId = document.getElementById("hiddenCourseId");
    const hiddenTopic = document.getElementById("hiddenTopic");
    const hiddenNotes = document.getElementById("hiddenNotes");
    const hiddenDurationMinutes = document.getElementById("hiddenDurationMinutes");

    const timerMessage = document.getElementById("timerMessage");
    const saveSessionForm = document.getElementById("saveSessionForm");

    function updateTimerDisplay() {
        const hours = Math.floor(elapsedSeconds / 3600);
        const minutes = Math.floor((elapsedSeconds % 3600) / 60);
        const seconds = elapsedSeconds % 60;

        timerDisplay.textContent =
            String(hours).padStart(2, "0") + ":" +
            String(minutes).padStart(2, "0") + ":" +
            String(seconds).padStart(2, "0");
    }

    startButton.addEventListener("click", function () {
        if (timerInterval !== null) {
            return;
        }

        timerInterval = setInterval(function () {
            elapsedSeconds++;
            updateTimerDisplay();
        }, 1000);

        timerMessage.textContent = "";
    });

    pauseButton.addEventListener("click", function () {
        clearInterval(timerInterval);
        timerInterval = null;
    });

    resetButton.addEventListener("click", function () {
        clearInterval(timerInterval);
        timerInterval = null;
        elapsedSeconds = 0;
        updateTimerDisplay();
        timerMessage.textContent = "";
    });

    saveButton.addEventListener("click", function () {
        if (courseId.value === "") {
            timerMessage.textContent = "Please select a course.";
            return;
        }

        if (topic.value.trim() === "") {
            timerMessage.textContent = "Please enter a topic.";
            return;
        }

        if (elapsedSeconds < 60) {
            timerMessage.textContent =
                "The timer must run for at least one minute before saving.";
            return;
        }

        clearInterval(timerInterval);
        timerInterval = null;

        const durationMinutes = Math.ceil(elapsedSeconds / 60);

        hiddenCourseId.value = courseId.value;
        hiddenTopic.value = topic.value;
        hiddenNotes.value = notes.value;
        hiddenDurationMinutes.value = durationMinutes;

        saveSessionForm.submit();
    });

    updateTimerDisplay();
</script>
