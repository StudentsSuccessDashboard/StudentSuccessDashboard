@model IEnumerable<StudentSuccessDashboard.Models.Exam>

@{
    ViewData["Title"] = "Exams";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">

    <div>
        <h1 class="mb-1">Exams</h1>
        <p class="text-muted mb-0">
            Manage upcoming exams and review exam details by course.
        </p>
    </div>

    <div class="d-flex flex-wrap gap-2">

        <a asp-action="Create"
           class="btn btn-primary">
            Create New Exam
        </a>

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>

    </div>

</div>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">

            <h4>No Exams Yet</h4>

            <p class="text-muted">
                Add your first exam to begin tracking important test dates.
            </p>

            <a asp-action="Create"
               class="btn btn-primary">
                Create Exam
            </a>

        </div>
    </div>
}
else
{
    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Course</th>
                            <th>Exam</th>
                            <th>Exam Date</th>
                            <th>Points Possible</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    @item.Course.CourseName
                                </td>

                                <td>
                                    <strong>
                                        @item.ExamName
                                    </strong>
                                </td>

                                <td>
                                    @item.ExamDate.ToString("MMM d, yyyy h:mm tt")
                                </td>

                                <td>
                                    @item.PointsPossible
                                </td>

                                <td class="text-end">

                                    <div class="d-flex flex-wrap justify-content-end gap-2">

                                        <a asp-action="Details"
                                           asp-route-id="@item.ExamId"
                                           class="btn btn-outline-primary btn-sm">
                                            Details
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.ExamId"
                                           class="btn btn-outline-warning btn-sm">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.ExamId"
                                           class="btn btn-outline-danger btn-sm">
                                            Delete
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
}