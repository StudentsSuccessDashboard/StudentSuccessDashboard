@model IEnumerable<StudentSuccessDashboard.Models.Exam>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ExamName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ExamDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PointsPossible)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CourseId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Course)
            </th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.ExamName)
                </td>
                <td>
                    @Html.DisplayFor(model => item.ExamDate)
                </td>
                <td>
                    @Html.DisplayFor(model => item.PointsPossible)
                </td>
                <td>
                    @Html.DisplayFor(model => item.CourseId)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Course)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ExamId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.ExamId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.ExamId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>