@model StudentSuccessDashboard.Models.Exam

@{
    ViewData["Title"] = "Edit Exam";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">

    <div>
        <h1 class="mb-1">Edit Exam</h1>
        <p class="text-muted mb-0">
            Update the exam information below.
        </p>
    </div>

    <a asp-controller="Dashboard"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Back to Dashboard
    </a>

</div>

<div class="card shadow-sm">

    <div class="card-body">

        <div class="row">

            <div class="col-lg-7 col-md-9">

                <form asp-action="Edit">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger">
                    </div>

                    <input type="hidden"
                           asp-for="ExamId" />

                    <div class="mb-3">

                        <label asp-for="ExamName"
                               class="form-label">
                        </label>

                        <input asp-for="ExamName"
                               class="form-control" />

                        <span asp-validation-for="ExamName"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="ExamDate"
                               class="form-label">
                        </label>

                        <input asp-for="ExamDate"
                               class="form-control"
                               type="datetime-local" />

                        <span asp-validation-for="ExamDate"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="PointsPossible"
                               class="form-label">
                        </label>

                        <input asp-for="PointsPossible"
                               class="form-control" />

                        <span asp-validation-for="PointsPossible"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-4">

                        <label asp-for="CourseId"
                               class="form-label">
                            Course
                        </label>

                        <select asp-for="CourseId"
                                class="form-select"
                                asp-items="ViewBag.CourseId">

                            <option value="">
                                Select a course
                            </option>

                        </select>

                        <span asp-validation-for="CourseId"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="d-flex flex-wrap gap-2">

                        <button type="submit"
                                class="btn btn-primary">
                            Save Changes
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}