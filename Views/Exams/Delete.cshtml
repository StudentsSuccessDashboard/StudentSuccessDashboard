@model StudentSuccessDashboard.Models.Exam

@{
    ViewData["Title"] = "Delete Exam";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">

    <div>
        <h1 class="mb-1">Delete Exam</h1>
        <p class="text-muted mb-0">
            Review the exam before permanently deleting it.
        </p>
    </div>

    <a asp-controller="Dashboard"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Back to Dashboard
    </a>

</div>

<div class="card shadow-sm border-danger">

    <div class="card-body">

        <div class="alert alert-danger">
            Are you sure you want to delete this exam?
            This action cannot be undone.
        </div>

        <dl class="row">

            <dt class="col-sm-3">
                Course
            </dt>

            <dd class="col-sm-9">
                @Model.Course.CourseName
            </dd>

            <dt class="col-sm-3">
                Exam
            </dt>

            <dd class="col-sm-9">
                @Model.ExamName
            </dd>

            <dt class="col-sm-3">
                Exam Date
            </dt>

            <dd class="col-sm-9">
                @Model.ExamDate.ToString("F")
            </dd>

            <dt class="col-sm-3">
                Points Possible
            </dt>

            <dd class="col-sm-9">
                @Model.PointsPossible
            </dd>

        </dl>

        <form asp-action="Delete">

            <input type="hidden"
                   asp-for="ExamId" />

            <div class="d-flex flex-wrap gap-2">

                <button type="submit"
                        class="btn btn-danger">
                    Delete Exam
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>