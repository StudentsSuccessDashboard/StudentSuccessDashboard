@model StudentSuccessDashboard.Models.Exam

@{
    ViewData["Title"] = "Delete Exam";
}

<h1>Delete Exam</h1>

<h3>Are you sure you want to delete this exam?</h3>

<div>
    <h4>Exam</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.ExamName)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.ExamName)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.ExamDate)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.ExamDate)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.PointsPossible)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.PointsPossible)
        </dd>

        <dt class="col-sm-3">
            Course
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Course.CourseName)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="ExamId" />

        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>