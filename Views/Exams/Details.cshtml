@model StudentSuccessDashboard.Models.Exam

@{
    ViewData["Title"] = "Exam Details";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">

    <div>
        <h1 class="mb-1">Exam Details</h1>
        <p class="text-muted mb-0">
            Review the selected exam information.
        </p>
    </div>

    <a asp-controller="Dashboard"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Back to Dashboard
    </a>

</div>

<div class="card shadow-sm">

    <div class="card-body">

        <dl class="row mb-0">

            <dt class="col-sm-3">
                Course
            </dt>

            <dd class="col-sm-9">
                @Model.Course.CourseName
            </dd>

            <dt class="col-sm-3">
                Exam
            </dt>

            <dd class="col-sm-9">
                @Model.ExamName
            </dd>

            <dt class="col-sm-3">
                Exam Date
            </dt>

            <dd class="col-sm-9">
                @Model.ExamDate.ToString("F")
            </dd>

            <dt class="col-sm-3">
                Points Possible
            </dt>

            <dd class="col-sm-9">
                @Model.PointsPossible
            </dd>

        </dl>

    </div>

</div>

<div class="d-flex flex-wrap gap-2 mt-3">

    <a asp-action="Edit"
       asp-route-id="@Model.ExamId"
       class="btn btn-primary">
        Edit Exam
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back to Exams
    </a>

    <a asp-controller="Calendar"
       asp-action="Index"
       asp-route-year="@Model.ExamDate.Year"
       asp-route-month="@Model.ExamDate.Month"
       class="btn btn-outline-primary">
        Back to Calendar
    </a>

</div>