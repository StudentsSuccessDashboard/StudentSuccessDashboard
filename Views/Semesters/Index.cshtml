@model IEnumerable<StudentSuccessDashboard.Models.Semester>

@{
    ViewData["Title"] = "Semesters";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">

    <div>
        <h1 class="mb-1">Semesters</h1>

        <p class="text-muted mb-0">
            Manage your academic terms and organize courses by semester.
        </p>
    </div>

    <div class="d-flex flex-wrap gap-2">

        <a asp-action="Create"
           class="btn btn-primary">
            Add Semester
        </a>

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>

    </div>

</div>

@if (!Model.Any())
{
    <div class="card shadow-sm">

        <div class="card-body text-center py-5">

            <h4>No Semesters Yet</h4>

            <p class="text-muted">
                Add your first semester to begin organizing your courses
                and academic schedule.
            </p>

            <a asp-action="Create"
               class="btn btn-primary">
                Add Semester
            </a>

        </div>

    </div>
}
else
{
    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table align-middle mb-0">

                    <thead>

                        <tr>
                            <th>Semester</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th class="text-end">Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @item.SemesterName
                                    </strong>
                                </td>

                                <td>
                                    @item.StartDate.ToString("MMM d, yyyy")
                                </td>

                                <td>
                                    @item.EndDate.ToString("MMM d, yyyy")
                                </td>

                                <td class="text-end">

                                    <div class="d-flex flex-wrap justify-content-end gap-2">

                                        <a asp-action="Edit"
                                           asp-route-id="@item.SemesterId"
                                           class="btn btn-outline-warning btn-sm">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.SemesterId"
                                           class="btn btn-outline-danger btn-sm">
                                            Delete
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
}