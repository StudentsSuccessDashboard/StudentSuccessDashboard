@model StudentSuccessDashboard.Models.Semester

@{
    ViewData["Title"] = "Delete Semester";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">

    <div>
        <h1 class="mb-1">Delete Semester</h1>

        <p class="text-muted mb-0">
            Review the semester before permanently deleting it.
        </p>
    </div>

    <a asp-controller="Dashboard"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Back to Dashboard
    </a>

</div>

<div class="card shadow-sm border-danger">

    <div class="card-body">

        <div class="alert alert-danger">
            Are you sure you want to delete this semester?
            This action cannot be undone.
        </div>

        <dl class="row">

            <dt class="col-sm-3">
                Semester
            </dt>

            <dd class="col-sm-9">
                @Model.SemesterName
            </dd>

            <dt class="col-sm-3">
                Start Date
            </dt>

            <dd class="col-sm-9">
                @Model.StartDate.ToString("MMMM d, yyyy")
            </dd>

            <dt class="col-sm-3">
                End Date
            </dt>

            <dd class="col-sm-9">
                @Model.EndDate.ToString("MMMM d, yyyy")
            </dd>

        </dl>

        <form asp-action="Delete">

            <input type="hidden"
                   asp-for="SemesterId" />

            <div class="d-flex flex-wrap gap-2">

                <button type="submit"
                        class="btn btn-danger">
                    Delete Semester
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>