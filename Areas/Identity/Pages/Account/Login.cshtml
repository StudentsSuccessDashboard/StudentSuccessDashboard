@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<style>
    .login-shell {
        min-height: calc(100vh - 150px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem 4rem;
    }

    .login-wrapper {
        width: 100%;
        max-width: 1100px;
    }

    .login-hero {
        border-radius: 24px;
        padding: 2.5rem;
        background: radial-gradient(circle at top left, rgba(13, 110, 253, 0.18), transparent 42%), linear-gradient( 135deg, var(--surface), var(--surface-soft) );
        border: 1px solid var(--border-color);
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.08);
    }

    .login-intro {
        max-width: 520px;
    }

    .login-badge {
        display: inline-block;
        padding: 0.45rem 0.8rem;
        margin-bottom: 1rem;
        border-radius: 999px;
        font-size: 0.85rem;
        font-weight: 600;
        background-color: var(--primary-soft);
        color: var(--text-heading);
    }

    .login-title {
        font-size: clamp(2rem, 4vw, 3.5rem);
        font-weight: 750;
        line-height: 1.05;
        margin-bottom: 1rem;
        color: var(--text-heading);
    }

    .login-subtitle {
        font-size: 1.05rem;
        line-height: 1.7;
        color: var(--text-muted);
        margin-bottom: 2rem;
    }

    .feature-list {
        display: grid;
        gap: 1rem;
    }

    .feature-item {
        display: flex;
        gap: 0.8rem;
        align-items: flex-start;
    }

    .feature-icon {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background-color: var(--primary-soft);
        font-size: 1.05rem;
    }

    .feature-item strong {
        color: var(--text-heading);
    }

    .feature-item p {
        margin: 0.15rem 0 0;
        color: var(--text-muted);
        font-size: 0.9rem;
    }

    .login-card {
        max-width: 460px;
        margin-left: auto;
        border-radius: 20px;
        border: 1px solid var(--border-color);
        background-color: var(--surface);
        padding: 2rem;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.07);
    }

        .login-card h2 {
            color: var(--text-heading);
            font-weight: 700;
        }

        .login-card .form-control {
            min-height: 52px;
            border-radius: 10px;
        }

        .login-card .btn-primary {
            min-height: 50px;
            border-radius: 10px;
            font-weight: 600;
        }

    .login-links {
        display: grid;
        gap: 0.6rem;
        margin-top: 1.25rem;
        font-size: 0.92rem;
    }

    .login-divider {
        height: 1px;
        background-color: var(--border-color);
        margin: 1.5rem 0;
    }

    .register-callout {
        text-align: center;
        color: var(--text-muted);
    }

        .register-callout a {
            font-weight: 600;
        }

    @@media (max-width: 991px) {
        .login-card {
            margin: 2rem auto 0;
        }

        .login-intro {
            max-width: none;
        }
    }
</style>

<div class="login-shell">

    <div class="login-wrapper">

        <div class="login-hero">

            <div class="row align-items-center g-5">

                <div class="col-lg-6">

                    <div class="login-intro">

                        <span class="login-badge">
                            Student Success Dashboard
                        </span>

                        <h1 class="login-title">
                            Welcome back.
                        </h1>

                        <p class="login-subtitle">
                            Sign in to manage your semester, track deadlines,
                            monitor your grades, and keep your study time organized
                            in one place.
                        </p>

                        <div class="feature-list">

                            <div class="feature-item">

                                <div class="feature-icon">
                                    📅
                                </div>

                                <div>
                                    <strong>
                                        Stay ahead of deadlines
                                    </strong>

                                    <p>
                                        Keep assignments, quizzes, exams, and calendar events organized.
                                    </p>
                                </div>

                            </div>

                            <div class="feature-item">

                                <div class="feature-icon">
                                    📊
                                </div>

                                <div>
                                    <strong>
                                        Track your progress
                                    </strong>

                                    <p>
                                        Review course averages, grades, GPA, and assignment completion.
                                    </p>
                                </div>

                            </div>

                            <div class="feature-item">

                                <div class="feature-icon">
                                    ⏱️
                                </div>

                                <div>
                                    <strong>
                                        Build better study habits
                                    </strong>

                                    <p>
                                        Record study sessions and monitor weekly study time.
                                    </p>
                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <div class="col-lg-6">

                    <div class="login-card">

                        <h2 class="mb-1">
                            Log In
                        </h2>

                        <p class="text-muted mb-4">
                            Enter your account information to continue.
                        </p>

                        <form id="account"
                              method="post">

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-3"
                                 role="alert">
                            </div>


                            <div class="form-floating mb-3">

                                <input asp-for="Input.Email"
                                       class="form-control"
                                       autocomplete="username"
                                       aria-required="true"
                                       placeholder="name@example.com" />

                                <label asp-for="Input.Email">
                                    Email
                                </label>

                                <span asp-validation-for="Input.Email"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="form-floating mb-3">

                                <input asp-for="Input.Password"
                                       class="form-control"
                                       autocomplete="current-password"
                                       aria-required="true"
                                       placeholder="Password" />

                                <label asp-for="Input.Password">
                                    Password
                                </label>

                                <span asp-validation-for="Input.Password"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="form-check mb-4">

                                <label asp-for="Input.RememberMe"
                                       class="form-check-label">

                                    <input class="form-check-input"
                                           asp-for="Input.RememberMe" />

                                    Remember me

                                </label>

                            </div>


                            <button id="login-submit"
                                    type="submit"
                                    class="w-100 btn btn-lg btn-primary">
                                Log In
                            </button>


                            <div class="login-links">

                                <a id="forgot-password"
                                   asp-page="./ForgotPassword">
                                    Forgot your password?
                                </a>

                                <a id="resend-confirmation"
                                   asp-page="./ResendEmailConfirmation">
                                    Resend email confirmation
                                </a>

                            </div>

                        </form>


                        <div class="login-divider">
                        </div>


                        <div class="register-callout">

                            <span>
                                New to Student Success Dashboard?
                            </span>

                            <br />

                            <a asp-page="./Register"
                               asp-route-returnUrl="@Model.ReturnUrl">
                                Create an account
                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}